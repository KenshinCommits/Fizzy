{
  "name": "fizzi-backend",
  "version": "1.0.0",
  "description": "Fizzi AI Sales & Customer Agent Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seedDatabase.ts",
    "db:migrate": "tsx src/utils/dbScripts.ts migrate",
    "db:validate": "tsx src/utils/dbScripts.ts validate",
    "db:indexes": "tsx src/utils/dbScripts.ts indexes",
    "db:status": "tsx src/utils/dbScripts.ts status",
    "db:seed:test": "NODE_ENV=test tsx src/utils/seed.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": ["fizzi", "crm", "ai-agent", "retell", "sales"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "zod": "^3.22.4",
    "socket.io": "^4.6.1",
    "axios": "^1.6.5",
    "twilio": "^4.20.0",
    "retell-sdk": "^2.0.0",
    "winston": "^3.11.0",
    "date-fns": "^3.0.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  }
}
